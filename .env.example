# Sao chép thành .env rồi chỉnh nếu cần: cp .env.example .env
# Giá trị dưới đây chỉ là giá trị MẪU cho môi trường phát triển.
DATABASE_URL=postgres://crm:crm_dev_password@localhost:5432/smart_crm
PORT=3000
# Đăng nhập cơ bản cho nhân viên. Giá trị mẫu cho môi trường phát triển, hãy đổi khi dùng thật.
AUTH_USERNAME=nhanvien
AUTH_PASSWORD=1234
AUTH_SECRET=chuoi-bi-mat-ngau-nhien-dai-it-nhat-32-ky-tu
# Lệch múi giờ (phút) dùng để xác định Chủ nhật khi tính hạn SLA. Việt Nam = UTC+7 = 420.
SLA_TZ_OFFSET_MINUTES=420
