# Sao chép: cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# KHÔNG commit .env. Giá trị dưới đây là giá trị MẪU chạy được; hãy đổi hết khi triển khai thật.

# Cổng mở ra máy chủ khi chạy bằng Docker (bị chiếm thì đổi sang 3001...)
APP_PORT=3000

# Cơ sở dữ liệu PostgreSQL
DB_NAME=smart_crm
DB_USER=crm
DB_PASSWORD=crm_dev_password
# Chỉ cần khi chạy Node trực tiếp: mặc định localhost và 5432 (trong Docker, compose tự đặt DB_HOST=db)
# DB_HOST=localhost
# DB_PORT=5432

# Đăng nhập cơ bản cho nhân viên. AUTH_SECRET là khoá ký phiên, nên dài ít nhất 32 ký tự
AUTH_USERNAME=nhanvien
AUTH_PASSWORD=1234
AUTH_SECRET=chuoi-bi-mat-ngau-nhien-dai-it-nhat-32-ky-tu

# Lệch múi giờ (phút) dùng để xác định Chủ nhật khi tính hạn SLA. Việt Nam = UTC+7 = 420
SLA_TZ_OFFSET_MINUTES=420
