l><mxCell id="e1" value="" style="endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3448;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_customer" target="t_ticket"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="400"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_device" target="t_ticket"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=0.0000;exitY=0.5263;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.1379;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_issue_category" target="t_ticket"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="100"/><mxPoint x="870" y="340"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=0.0000;exitY=0.5435;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5862;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_sla_config" target="t_ticket"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;html=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_sla_config" target="t_issue_category"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_ticket" target="t_ticket_status_log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;CHÚ THÍCH KÝ HIỆU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đường nối: bảng cha (đầu ||, o|) → bảng con (đầu &lt;).&lt;br&gt;||   đúng một        o|   không hoặc một&lt;br&gt;|&lt;   một hoặc nhiều        o&lt;   không hoặc nhiều&lt;br&gt;[PK] khóa chính (khóa nhân tạo)   [FK] khóa ngoại&lt;br&gt;UNIQUE = khóa nghiệp vụ (không dùng làm khóa chính)&lt;br&gt;1 khách hàng có 0..n thiết bị và 0..n phiếu bảo hành.&lt;br&gt;1 phiếu bảo hành có ≥ 1 dòng trong lịch sử trạng thái.&lt;br&gt;1 mức ưu tiên (sla_config) dùng cho 0..n phiếu; nhóm sự cố có&lt;br&gt;mức ưu tiên mặc định tùy chọn (default_priority, có thể rỗng).&lt;br&gt;Thuật ngữ khớp SRS mục 1.5: phiếu bảo hành = ticket.&lt;br&gt;Giá trị tính ra không lưu: tình trạng bảo hành tính từ&lt;br&gt;purchase_date + warranty_months." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="400" height="330" as="geometry"/></mxCell><mxCell id="idxbox" value="&lt;b&gt;INDEX DỰ KIẾN (phục vụ yêu cầu nào)&lt;/b&gt;&lt;br&gt;&lt;br&gt;customer(phone) UNIQUE → NFR1, US1&lt;br&gt;ticket(status, due_date) → FR7, FR10 (US7, US9)&lt;br&gt;ticket(customer_id, received_at) → US1 (lịch sử)&lt;br&gt;device(customer_id) → US3&lt;br&gt;ticket_status_log(ticket_id, changed_at) → BR5&lt;br&gt;serial_no, ticket_code, category_name: UNIQUE&lt;br&gt;(UNIQUE tự sinh index)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="920" y="560" width="340" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>