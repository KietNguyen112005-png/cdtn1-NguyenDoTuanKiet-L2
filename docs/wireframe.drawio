xt;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=10;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1538" y="564.3" width="89" height="15" as="geometry"/></mxCell><mxCell id="w266" value="" style="whiteSpace=wrap;html=0;fillColor=#222222;strokeColor=#000000;strokeWidth=1.2;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="1234" y="614" width="170" height="32" as="geometry"/></mxCell><mxCell id="w267" value="In biên nhận PDF" style="text;html=0;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontSize=10;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1234" y="614" width="170" height="32" as="geometry"/></mxCell><mxCell id="w268" value="" style="whiteSpace=wrap;html=0;fillColor=#000000;strokeColor=#000000;strokeWidth=1;rounded=1;absoluteArcSize=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1410" y="622" width="28.427083333333332" height="15" as="geometry"/></mxCell><mxCell id="w269" value="C14" style="text;html=0;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontSize=9;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1410" y="622" width="28.427083333333332" height="15" as="geometry"/></mxCell><mxCell id="w270" value="" style="whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="1590" y="614" width="176" height="32" as="geometry"/></mxCell><mxCell id="w271" value="‹ Quay lại danh sách" style="text;html=0;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontSize=10;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1590" y="614" width="176" height="32" as="geometry"/></mxCell><mxCell id="w272" value="" style="whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="685" width="1760" height="125" as="geometry"/></mxCell><mxCell id="w273" value="CHÚ THÍCH KÝ HIỆU" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="32" y="692" width="124" height="17" as="geometry"/></mxCell><mxCell id="w274" value="Khung có thanh tiêu đề = một màn hình.  Ô chữ nhật = ô nhập liệu (chữ xám = dữ liệu mẫu).  Nút bo góc (nền đen = hành động chính).  Hình tròn = lựa chọn một.  Nhãn nền đen (A1, B3, C7…) = mã trường: đối chiếu với bảng &quot;Trường trên màn hình → cột dữ liệu → nguồn&quot;." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=10;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="32" y="712" width="1286" height="15" as="geometry"/></mxCell><mxCell id="w275" value="Nền xám nhạt = trường tự tính, không nhập tay.  Dòng &quot;⚠&quot; = chỗ hiển thị thông báo lỗi cho luồng ngoại lệ của use case (ví dụ không tìm thấy khách hàng)." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=10;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="32" y="730" width="735" height="15" as="geometry"/></mxCell><mxCell id="w276" value="Thuật ngữ khớp bảng thuật ngữ SRS mục 1.5: phiếu bảo hành, khách hàng, thiết bị, nhóm sự cố, mức ưu tiên, hạn cam kết (SLA).  Không vẽ màu sắc, phông chữ, hình ảnh (đúng yêu cầu BT1)." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=10;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="32" y="748" width="904" height="15" as="geometry"/></mxCell><mxCell id="w277" value="Luồng giữa các màn hình:  A (danh sách) → bấm &quot;+ Tạo phiếu mới&quot; → B (tạo phiếu) → bấm &quot;Lưu phiếu&quot; → C (chi tiết) → &quot;Quay lại danh sách&quot; → A." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=10;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="32" y="766" width="685" height="15" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>