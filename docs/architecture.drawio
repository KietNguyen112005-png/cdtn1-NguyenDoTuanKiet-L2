<mxfile host="app.diagrams.net"><diagram name="Kien truc L2" id="arch-l2"><mxGraphModel dx="1200" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_title" value="KIẾN TRÚC PHÂN LỚP – Luồng L2: Tiếp nhận và phân loại yêu cầu bảo hành (track SE)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="30" as="geometry"/></mxCell><mxCell id="c_a1" value="Nhân viên tiếp nhận&#xa;(actor – ngoài hệ thống)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="150" y="52" width="240" height="34" as="geometry"/></mxCell><mxCell id="c_a2" value="Quản lý trung tâm&#xa;(actor – ngoài hệ thống)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="52" width="240" height="34" as="geometry"/></mxCell><mxCell id="c_a3" value="Kỹ thuật viên&#xa;(actor – ngoài hệ thống)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="810" y="52" width="240" height="34" as="geometry"/></mxCell><mxCell id="c_L1" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F4F4;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1120" height="118" as="geometry"/></mxCell><mxCell id="c_L1_t" value="1 · LỚP TRÌNH BÀY (React) – nhận nhập liệu, hiển thị kết quả; KHÔNG chứa quy tắc nghiệp vụ, KHÔNG truy vấn dữ liệu trực tiếp" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="134" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c_p1" value="Màn hình&#xa;danh sách phiếu" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="166" width="240" height="64" as="geometry"/></mxCell><mxCell id="c_p2" value="Màn hình&#xa;tạo phiếu bảo hành" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="166" width="240" height="64" as="geometry"/></mxCell><mxCell id="c_p3" value="Màn hình&#xa;chi tiết phiếu" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="166" width="240" height="64" as="geometry"/></mxCell><mxCell id="c_p4" value="Khu vực cấu hình SLA&#xa;(trên màn hình danh sách)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="166" width="240" height="64" as="geometry"/></mxCell><mxCell id="c_L2" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F4F4;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1120" height="170" as="geometry"/></mxCell><mxCell id="c_L2_t" value="2 · LỚP NGHIỆP VỤ (Service) – TOÀN BỘ quy tắc nghiệp vụ BR1–BR8 nằm trong lớp này" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="304" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c_s1" value="TicketService&#xa;Tạo phiếu, kiểm tra bắt buộc (BR3),&#xa;bảo hành (BR1), ghi lịch sử (BR5)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="336" width="240" height="84" as="geometry"/></mxCell><mxCell id="c_s2" value="CustomerService&#xa;Tra cứu, tạo khách hàng;&#xa;chuẩn hóa SĐT (BR6)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="336" width="240" height="84" as="geometry"/></mxCell><mxCell id="c_s3" value="SlaService&#xa;Tính hạn cam kết (BR2);&#xa;cấu hình SLA theo mức ưu tiên" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="336" width="240" height="84" as="geometry"/></mxCell><mxCell id="c_s4" value="AccessControl&#xa;Kiểm tra vai trò, phạm vi&#xa;trung tâm, che SĐT (BR8, NFR3)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="336" width="240" height="84" as="geometry"/></mxCell><mxCell id="c_s5" value="NotificationService – báo phiếu MỚI cho kỹ thuật viên (hiển thị trong danh sách phiếu, trong hệ thống)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="510" height="30" as="geometry"/></mxCell><mxCell id="c_L3" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F4F4;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1120" height="100" as="geometry"/></mxCell><mxCell id="c_L3_t" value="3 · LỚP TRUY CẬP DỮ LIỆU (Repository) – chỉ đọc/ghi dữ liệu; KHÔNG chứa quy tắc nghiệp vụ" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="524" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c_r1" value="CustomerRepository" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="200" height="40" as="geometry"/></mxCell><mxCell id="c_r2" value="DeviceRepository" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="278" y="560" width="200" height="40" as="geometry"/></mxCell><mxCell id="c_r3" value="TicketRepository" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="496" y="560" width="200" height="40" as="geometry"/></mxCell><mxCell id="c_r4" value="IssueCategoryRepository" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="714" y="560" width="200" height="40" as="geometry"/></mxCell><mxCell id="c_r5" value="SlaConfigRepository" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="932" y="560" width="200" height="40" as="geometry"/></mxCell><mxCell id="c_L4" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F4F4;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1120" height="100" as="geometry"/></mxCell><mxCell id="c_L4_t" value="4 · LỚP LƯU TRỮ – PostgreSQL (toàn vẹn bằng khóa chính, khóa ngoại, NOT NULL, CHECK)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="674" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c_t0" value="customer" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="168" height="40" as="geometry"/></mxCell><mxCell id="c_t1" value="device" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="242" y="710" width="168" height="40" as="geometry"/></mxCell><mxCell id="c_t2" value="ticket" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="424" y="710" width="168" height="40" as="geometry"/></mxCell><mxCell id="c_t3" value="ticket_status_log" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="606" y="710" width="168" height="40" as="geometry"/></mxCell><mxCell id="c_t4" value="issue_category" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="788" y="710" width="168" height="40" as="geometry"/></mxCell><mxCell id="c_t5" value="sla_config" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="710" width="168" height="40" as="geometry"/></mxCell><mxCell id="c_leg" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="640" height="190" as="geometry"/></mxCell><mxCell id="c_leg_t" value="CHÚ THÍCH KÝ HIỆU" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="52" y="806" width="600" height="20" as="geometry"/></mxCell><mxCell id="c_leg0" value="Khung xám: một lớp kiến trúc (đánh số 1–4 từ trên xuống)." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="832" width="620" height="20" as="geometry"/></mxCell><mxCell id="c_leg1" value="Hình chữ nhật trắng: một thành phần (màn hình, service, repository, bảng)." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="853" width="620" height="20" as="geometry"/></mxCell><mxCell id="c_leg2" value="Khung nét đứt: tác nhân (actor) nằm ngoài ranh giới hệ thống." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="874" width="620" height="20" as="geometry"/></mxCell><mxCell id="c_leg3" value="Mũi tên liền: lời gọi và hướng phụ thuộc MỘT CHIỀU, từ lớp trên xuống lớp dưới;" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="895" width="620" height="20" as="geometry"/></mxCell><mxCell id="c_leg4" value="     nhãn trên mũi tên là cách hai lớp trao đổi (giao thức / giao diện)." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="916" width="620" height="20" as="geometry"/></mxCell><mxCell id="c_leg5" value="BRn, NFRn: quy tắc nghiệp vụ và yêu cầu phi chức năng trong bản SRS (mục 4, 5)." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="937" width="620" height="20" as="geometry"/></mxCell><mxCell id="c_leg6" value="Thuật ngữ khớp bảng thuật ngữ SRS mục 1.5: phiếu bảo hành = bảng ticket." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="958" width="620" height="20" as="geometry"/></mxCell><mxCell id="c_oos" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="800" width="460" height="190" as="geometry"/></mxCell><mxCell id="c_oos_t" value="NGOÀI PHẠM VI (WON&#x27;T)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="712" y="806" width="430" height="20" as="geometry"/></mxCell><mxCell id="c_oos0" value="W1  Phân công kỹ thuật viên theo tay nghề, địa bàn (L4)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="712" y="834" width="440" height="20" as="geometry"/></mxCell><mxCell id="c_oos1" value="W2  Theo dõi tiến độ sửa chữa sau khi chuyển giao phiếu" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="712" y="858" width="440" height="20" as="geometry"/></mxCell><mxCell id="c_oos2" value="W3  Quản lý kho và xuất linh kiện thay thế (L5)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="712" y="882" width="440" height="20" as="geometry"/></mxCell><mxCell id="c_oos3" value="W4  Tự động phân loại lỗi bằng AI/NLP (L10)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="712" y="906" width="440" height="20" as="geometry"/></mxCell><mxCell id="c_oos4" value="W5  Tích hợp tổng đài VoIP, SMS, Zalo OA" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="712" y="930" width="440" height="20" as="geometry"/></mxCell><mxCell id="c_oos5" value="W6  Phê duyệt phiếu &quot;chưa xác minh bảo hành&quot;" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="712" y="954" width="440" height="20" as="geometry"/></mxCell><mxCell id="c_e0" value="Trình duyệt (HTTPS)" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="86" as="sourcePoint"/><mxPoint x="600" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_e0a" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="86" as="sourcePoint"/><mxPoint x="270" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_e0b" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="86" as="sourcePoint"/><mxPoint x="930" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_e1" value="HTTP + JSON (hợp đồng API: docs/api-contract.md)" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="248" as="sourcePoint"/><mxPoint x="600" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_e2" value="gọi qua giao diện Repository" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="470" as="sourcePoint"/><mxPoint x="600" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_e3" value="SQL" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="620" as="sourcePoint"/><mxPoint x="600" y="670" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><